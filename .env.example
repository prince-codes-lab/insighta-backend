# MongoDB
MONGODB_URI=mongodb://localhost:27017/insighta
SEED_FILE_PATH=./seed_profiles.json

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# GitHub OAuth App
# Create at: https://github.com/settings/developers → OAuth Apps → New
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Web portal URL (for CORS and post-login redirect)
WEB_PORTAL_URL=http://localhost:5173

PORT=3000
NODE_ENV=development
